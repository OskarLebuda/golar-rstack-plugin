{
  "name": "golar-rstack-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" -r run build",
    "dev": "pnpm --filter \"./packages/*\" -r run dev",
    "test": "pnpm --filter \"./packages/*\" -r run test",
    "lint": "rslint",
