{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["npm", "github-actions"],
  "rangeStrategy": "replace",
  "timezone": "Europe/Warsaw",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 2,
  "dependencyDashboard": true,
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "golar and its language plugins move in lockstep, and the diagnostic parser is pinned to their output format. Group them so a bump is reviewed as one change.",
      "matchPackageNames": ["golar", "@golar/**"],
      "groupName": "golar (lockstep, parser-sensitive)",
      "labels": ["dependencies", "golar"]
    },
    {
      "description": "Rstack toolchain",
      "matchPackageNames": ["@rsbuild/**", "@rspack/**", "@rslib/**", "@rstest/**", "@rslint/**"],
      "groupName": "rstack toolchain",
      "labels": ["dependencies", "rstack"]
    },
    {
      "description": "Dev tooling churns often and carries little risk",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dev dependencies",
      "labels": ["dependencies"]
    }
  ]
}
