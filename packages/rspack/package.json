{
  "name": "@golar-rstack/rspack",
  "type": "module",
  "version": "0.1.0",
  "description": "Run golar type checking and linting in a separate process as an Rspack plugin",
  "license": "MIT",
  "author": "Oskar Lebuda",
  "keywords": [
    "golar",
    "rspack",
    "rspack-plugin",
    "typecheck",
    "typescript",
    "vue",
    "svelte",
    "astro",
    "rstack"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "test": "rstest run",
    "check:publish": "publint && attw --pack ."
  },
  "dependencies": {
    "@golar-rstack/core": "workspace:*"
  },
  "peerDependencies": {
    "@rspack/core": "^1.0.0 || ^2.0.0",
    "golar": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@rspack/core": {
      "optional": true
    },
    "golar": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rslib/core": "^0.23.2",
    "@rspack/core": "^2.1.5",
    "@rstest/core": "^0.11.4",
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  }
}
